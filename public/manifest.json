{
    "name": "LostMate AI - Campus Lost & Found",
    "short_name": "LostMate",
    "description": "Report lost and found items on campus and get AI-suggested matches.",
    "start_url": "/dashboard",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#f7f3eb",
    "theme_color": "#1a1917",
    "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "I lost something", "url": "/lost-items/create", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "I found something", "url": "/found-items/create", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
